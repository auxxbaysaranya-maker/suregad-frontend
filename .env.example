# Copy to .env. These values are public in the browser. Do not put server secrets here.

# Origin of the SureGad API, e.g. https://api.suregad.com (no trailing slash).
# Leave empty in local development: Vite proxies /api, /media and /socket.io to http://localhost:4000.
VITE_API_URL=
# Production API: https://suregad-backend.onrender.com (the Pages workflow uses it by default)

# Path the site is served from. "/" locally; the GitHub Pages workflow sets "/<repo-name>/".
VITE_BASE_PATH=/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_VAPID_KEY=
VITE_VAPID_PUBLIC_KEY=
